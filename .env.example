# Copy to .env.local and fill through your own secure configuration process.
# Empty values are intentional. No real keys are included.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Exact company domains, comma separated, without @ or wildcards.
ALLOWED_EMAIL_DOMAINS=
# The approved Slack workspace identifier, not its display name.
ALLOWED_SLACK_TEAM_ID=
# T059 setup guide: docs/setup/T059-test-environment.md
# Configuration checks are offline; real service acceptance is a separate step.

# Exact application origin for Clerk token authorized-party validation.
APP_ORIGIN=http://127.0.0.1:3211
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/help-centre
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/help-centre
# Rebuild after changing public Clerk configuration. Both company email and Slack are verified.

# Direct or session-pooled PostgreSQL; distinct restricted logins, never migration owner.
# Remote connections require sslmode=verify-full. Restart after changing these secrets.
JUYU_DATABASE_RUNTIME_URL=
JUYU_DATABASE_ISSUER_URL=

# Optional absolute path to an installed Playwright-compatible Chromium binary.
# When empty, playwright-core uses its local browser installation; no remote PDF service.
PDF_CHROMIUM_EXECUTABLE=
