{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "env": {
    "JUYU_PERFORMANCE_LOGGING": "true",
    "JUYU_DEVELOPER_LOGGING": "true"
  },
  "buildCommand": "npm run verify:build",
  "crons": [
    {
      "path": "/api/cron/slack-notifications",
      "schedule": "*/5 * * * *"
    }
  ]
}
