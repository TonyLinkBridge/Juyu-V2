{
  "name": "juyu-help-centre-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:db": "node --experimental-strip-types --test --test-concurrency=1 tests/database/*.test.ts",
    "test:pdf": "node --experimental-strip-types --test --test-concurrency=1 tests/pdf/*.test.ts",
    "test:scale": "node --experimental-strip-types --test --test-concurrency=1 tests/performance/*.test.ts",
    "check:config": "node --experimental-strip-types scripts/check-test-environment.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/katex": "0.16.8",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.13.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@blocknote/core": "0.54.0",
    "@blocknote/mantine": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@clerk/localizations": "4.16.0",
    "@clerk/nextjs": "7.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "katex": "0.18.7",
    "mermaid": "11.17.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
