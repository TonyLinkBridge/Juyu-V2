{
  "name": "juyu-help-centre-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "test": "node scripts/run-isolated-unit-tests.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:db": "node --experimental-strip-types --test --test-concurrency=1 tests/database/*.test.ts",
    "test:pdf": "node --experimental-strip-types --test --test-concurrency=1 tests/pdf/*.test.ts",
    "test:scale": "node --experimental-strip-types --test --test-concurrency=1 tests/performance/*.test.ts",
    "check:config": "node --experimental-strip-types scripts/check-test-environment.ts",
    "test:recovery": "node --experimental-strip-types --test --test-concurrency=1 tests/recovery/*.test.ts",
    "postbuild": "node scripts/check-built-styles.mjs && node scripts/check-built-browser.mjs",
    "verify:build": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:critical": "playwright test tests/e2e/foundation.spec.ts tests/e2e/editor.spec.ts tests/e2e/favorites.spec.ts tests/e2e/favorites-reader.spec.ts tests/e2e/ops.spec.ts tests/e2e/reference.spec.ts tests/e2e/qa.spec.ts tests/e2e/qa-reuse.spec.ts tests/e2e/pending-ui.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.13.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@blocknote/core": "0.54.2",
    "@blocknote/diagram-block": "0.54.2",
    "@blocknote/mantine": "0.54.2",
    "@blocknote/math-block": "0.54.2",
    "@blocknote/react": "0.54.2",
    "@clerk/backend": "3.17.1",
    "@clerk/localizations": "4.16.0",
    "@clerk/nextjs": "7.9.1",
    "@fumadocs/language": "^0.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@sparticuz/chromium": "153.0.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "fumadocs-core": "16.15.13",
    "fumadocs-ui": "16.15.13",
    "katex": "0.18.7",
    "lucide-react": "1.47.0",
    "mermaid": "11.17.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "playwright-core": "1.62.1",
    "prosemirror-tables": "1.8.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.3"
  }
}
